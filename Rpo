UIS.InputBegan:Connect(function(inp, proc)
    if proc or not sheriffAimOn then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

    local tool = getMyTool()
    if not tool then return end
    local tn = tool.Name:lower()
    if not (tn:find("gun") or tn:find("sheriff") or tn:find("revolver")) then return end

    -- หาฆาตกรแล้ว Snap กล้องตรงหน้า
    local murderer = findMurderer()
    if murderer and murderer.Character then
        local mRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
        if mRoot then
            -- หมุนกล้องเข้าหาฆาตกรทันที
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, mRoot.Position)

            -- หมุนตัว Character ด้วย
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                myRoot.CFrame = CFrame.new(
                    myRoot.Position,
                    Vector3.new(mRoot.Position.X, myRoot.Position.Y, mRoot.Position.Z)
                )
            end
        end
    end
end)

