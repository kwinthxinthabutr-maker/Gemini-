-- ตรวจจับมีดที่ถูกปา → วาปไปหาคนใกล้สุด
workspace.DescendantAdded:Connect(function(obj)
    if not throwAimOn then return end
    task.wait(0.04)

    if not obj:IsA("BasePart") then return end
    local n = obj.Name:lower()
    if not (n:find("knife") or n:find("blade") or n:find("throw")) then return end

    -- ตรวจว่าไม่ใช่มีดใน Character ใคร
    local ancestor = obj:FindFirstAncestorOfClass("Model")
    if ancestor and Players:GetPlayerFromCharacter(ancestor) then return end

    local nearest = getNearestPlayer(300)
    if nearest and nearest.Character then
        local nRoot = nearest.Character:FindFirstChild("HumanoidRootPart")
        if nRoot then
            obj.CFrame = nRoot.CFrame
        end
    end
end)

-- ── Knife Slash Hitbox ─────────────────────
local slashBtn = makeBtn("⚔️", "Knife Slash (Auto-Close)", 22)
slashBtn.MouseButton1Click:Connect(function()
    slashOn = not slashOn
    slashBtn.Text             = "⚔️  Knife Slash  [" .. (slashOn and "ON" or "OFF") .. "]"
    slashBtn.BackgroundColor3 = slashOn and Color3.fromRGB(200,40,40) or Color3.fromRGB(38,38,50)

    if slashOn then
        slashConn = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if not char then return end

            local tool = getMyTool()
            if not tool then return end
            if not (tool.Name:lower():find("knife") or tool.Name:lower():find("blade")) then return end

            -- เช็คว่ากดเมาส์ซ้ายอยู่ (กำลัง Slash)
            if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                local nearest = getNearestPlayer(slashRange)
                if nearest and nearest.Character then
                    local nRoot = nearest.Character:FindFirstChild("HumanoidRootPart")
                    local myRoot = char:FindFirstChild("HumanoidRootPart")
                    if nRoot and myRoot then
                        -- เลื่อนตัวเราให้ชิดผู้เล่นนั้น
                        local dir = (myRoot.Position - nRoot.Position)
                        local safeDist = 2.5  -- ห่างพอดีให้ตี
                        myRoot.CFrame = CFrame.new(
                            nRoot.Position + dir.Unit * safeDist,
                            nRoot.Position
                        )
                    end
                end
            end
        end)
    else
        if slashConn then slashConn:Disconnect(); slashConn = nil end
    end
end)

