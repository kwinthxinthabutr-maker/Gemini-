-- หาผู้เล่นที่ใกล้ที่สุด
local function getNearestPlayer(maxDist)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest, nearDist = nil, maxDist or math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local pHum  = p.Character:FindFirstChild("Humanoid")
            if pRoot and pHum and pHum.Health > 0 then
                local d = (root.Position - pRoot.Position).Magnitude
                if d < nearDist then
                    nearest  = p
                    nearDist = d
                end
            end
        end
    end
    return nearest
end

-- หาฆาตกร (ถือมีด)
local function findMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            for _, t in pairs(p.Character:GetChildren()) do
                if t:IsA("Tool") then
                    local n = t.Name:lower()
                    if n:find("knife") or n:find("blade") then
                        return p
                    end
                end
            end
        end
    end
end

-- ดูว่าเราถือ Tool อะไรอยู่
local function getMyTool()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Tool")
end

