-- ── Sheriff Aimbot ─────────────────────────
local sheriffBtn = makeBtn("🎯", "Sheriff Aimbot", 12)
sheriffBtn.MouseButton1Click:Connect(function()
    sheriffAimOn = not sheriffAimOn
    sheriffBtn.Text             = "🎯  Sheriff Aimbot  [" .. (sheriffAimOn and "ON" or "OFF") .. "]"
