local function makeSec(txt, order)
    local l = Instance.new("TextLabel")
    l.Size               = UDim2.new(1, -8, 0, 20)
    l.BackgroundTransparency = 1
    l.Text               = "── " .. txt .. " ──"
    l.TextColor3         = Color3.fromRGB(140, 140, 160)
    l.TextScaled         = true
    l.Font               = Enum.Font.GothamMedium
    l.LayoutOrder        = order
    l.Parent             = scroll
end

local function makeBtn(icon, lbl, order)
    local b = Instance.new("TextButton")
    b.Size             = UDim2.new(1, -8, 0, 34)
    b.BackgroundColor3 = Color3.fromRGB(38, 38, 50)
    b.Text             = icon .. "  " .. lbl .. "  [OFF]"
    b.TextColor3       = Color3.fromRGB(200, 200, 210)
    b.TextScaled       = true
    b.Font             = Enum.Font.Gotham
    b.BorderSizePixel  = 0
    b.LayoutOrder      = order
    b.Parent           = scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local function makeSlider(label, min, max, default, order, onChange)
    local c = Instance.new("Frame")
    c.Size             = UDim2.new(1, -8, 0, 50)
    c.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    c.BorderSizePixel  = 0
    c.LayoutOrder      = order
    c.Parent           = scroll
    Instance.new("UICorner", c).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size                  = UDim2.new(1, -10, 0, 18)
    lbl.Position              = UDim2.new(0, 8, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text                  = label .. ": " .. default
    lbl.TextColor3            = Color3.fromRGB(190, 190, 200)
    lbl.TextScaled            = true
    lbl.Font                  = Enum.Font.Gotham
    lbl.TextXAlignment        = Enum.TextXAlignment.Left
    lbl.Parent                = c

    local function mkPM(txt, xPos)
        local b = Instance.new("TextButton")
        b.Size             = UDim2.new(0, 30, 0, 22)
        b.Position         = UDim2.new(0, xPos, 0, 24)
        b.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
        b.Text             = txt
        b.TextColor3       = Color3.fromRGB(255,255,255)
        b.TextScaled       = true
        b.Font             = Enum.Font.GothamBold
        b.BorderSizePixel  = 0
        b.Parent           = c
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        return b
    end

    local minus  = mkPM("-", 8)
    local valLbl = Instance.new("TextLabel")
    valLbl.Size               = UDim2.new(0, 55, 0, 22)
    valLbl.Position           = UDim2.new(0, 44, 0, 24)
    valLbl.BackgroundTransparency = 1
    valLbl.Text               = tostring(default)
    valLbl.TextColor3         = Color3.fromRGB(255, 200, 50)
    valLbl.TextScaled         = true
    valLbl.Font               = Enum.Font.GothamBold
    valLbl.Parent             = c

    local plus = mkPM("+", 105)
    local cur  = default

    minus.MouseButton1Click:Connect(function()
        cur = math.max(min, cur - 1)
        valLbl.Text = tostring(cur)
        lbl.Text    = label .. ": " .. cur
        if onChange then onChange(cur) end
    end)
    plus.MouseButton1Click:Connect(function()
        cur = math.min(max, cur + 1)
        valLbl.Text = tostring(cur)
        lbl.Text    = label .. ": " .. cur
        if onChange then onChange(cur) end
    end)
end

