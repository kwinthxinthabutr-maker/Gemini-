--========================================================--
-- LOADING FUNCTION
--========================================================--

local function startLoading()

	preLoad.Visible = false
	loading.Visible = true

	local loadingMessages = {
		"Initializing...",
		"Loading interface...",
		"Preparing assets...",
		"Connecting...",
		"Almost ready..."
	}

	for i = 0, 100 do

		local percent = i / 100

		progress.Size = UDim2.new(percent, 0, 1, 0)
		percentage.Text = tostring(i) .. "%"

		local messageIndex = math.clamp(
			math.floor(i / 20) + 1,
			1,
			#loadingMessages
		)

		loadingStatus.Text = loadingMessages[messageIndex]

		task.wait(CONFIG.LoadingTime / 100)
	end

	loadingStatus.Text = "Complete!"

	task.wait(0.5)

	-- Fade loading screen
	for _, object in ipairs(loading:GetDescendants()) do

		if object:IsA("TextLabel") then
			tween(object, 0.4, {
				TextTransparency = 1
			})

		elseif object:IsA("Frame") then
			tween(object, 0.4, {
				BackgroundTransparency = 1
			})
		end

	end

	task.wait(0.5)

	loading.Visible = false
	main.Visible = true

	-- Main UI entrance animation
	main.Size = UDim2.fromOffset(600, 360)
	main.BackgroundTransparency = 1

	tween(main, 0.5, {
		Size = UDim2.fromOffset(750, 460),
		BackgroundTransparency = 0
	}, Enum.EasingStyle.Back)

	opened = true
end

